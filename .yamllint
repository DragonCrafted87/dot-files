extends: default

ignore: |
  omp.yaml
  shell/omp.yaml

rules:
  indentation:
    spaces: 2
    indent-sequences: consistent
    check-multi-line-strings: true
  document-start:
    present: false
  hyphens:
    max-spaces-after: 1
  line-length:
    max: 120
    allow-non-breakable-inline-mappings: true
  truthy:
    check-keys: false

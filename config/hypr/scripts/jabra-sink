#!/usr/bin/env python3
"""Print the PipeWire id of the Jabra Speak sink."""

import json
import subprocess
import sys


def main():
    try:
        data = json.loads(subprocess.check_output(["pw-dump"], text=True))
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        print(exc, file=sys.stderr)
        return 1
    if not isinstance(data, list):
        print("unexpected pw-dump", file=sys.stderr)
        return 1
    for obj in data:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = (obj.get("info") or {}).get("props") or {}
        if props.get("media.class") != "Audio/Sink":
            continue
        blob = " ".join(
            str(props.get(key, ""))
            for key in ("node.description", "node.nick", "node.name", "device.description")
        ).lower()
        if "jabra" not in blob:
            continue
        ident = obj.get("id")
        if ident is None:
            ident = props.get("object.id")
        if ident is None:
            continue
        print(ident)
        return 0
    print("no Jabra sink", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())

{
    "git.useIntegratedAskPass": true,
    "git.terminalAuthentication": true,
    "git.autofetch": true,
    "remote.SSH.enableX11Forwarding": false,
    "terminal.integrated.env.linux": {
        "SSH_ASKPASS_REQUIRE": "never"
    },
    "debug.terminal.clearBeforeReusing": true,
    "editor.codeActionsOnSave": {},
    // Controls whether syntax highlighting should be copied into the clipboard.
    "editor.copyWithSyntaxHighlighting": false,
    "editor.minimap.size": "fit",
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.renderWhitespace": "boundary",
    "editor.suggest.localityBonus": true,
    "editor.unicodeHighlight.allowedCharacters": {
        "°": true,
    },
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.expandSingleFolderWorkspaces": false,
    "explorer.openEditors.sortOrder": "fullPath",
    "files.eol": "\n",
    "files.hotExit": "onExitAndWindowClose",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.branchProtection": [
        "main"
    ],
    "git.openRepositoryInParentFolders": "always",
    "git.suggestSmartCommit": false,
    "github.gitProtocol": "ssh",
    "projectManager.git.ignoredFolders": [
        "node_modules",
        "out",
        "typings",
        "test",
        ".haxelib",
        ".cache",
        ".cmake_build",
    ],
    "projectManager.groupList": true,
    "projectManager.removeCurrentProjectFromList": false,
    "projectManager.showParentFolderInfoOnDuplicates": true,
    "projectManager.sortList": "Name",
    "projectManager.tags": [],
    "security.workspace.trust.untrustedFiles": "open",
    "sonarlint.disableTelemetry": true,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.allowChords": false,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.profiles.windows": {
        "Git Bash": {
            "source": "Git Bash",
        },
    },
    "terminal.integrated.shellIntegration.enabled": false,
    "terminal.integrated.tabs.focusMode": "singleClick",
    "window.restoreFullscreen": true,
    "window.restoreWindows": "folders",
    "window.title": "${dirty}${activeEditorMedium}${separator}${rootName}${separator}${remoteName}",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.showTabs": "single",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "{hexdiff}:/**/*.*": "hexEditor.hexedit",
        "*.md": "default",
        "*.pdf": "pdf.preview",
        "{git,gitlens}:/**/*.{md,csv,svg}": "default",
        "*.qrc": "qt-core.qrcEditor",
    },
    "workbench.startupEditor": "none",
    "workbench.tree.renderIndentGuides": "always",
    "git.pruneOnFetch": true,
    "git.pullBeforeCheckout": true,
    "git.timeline.showUncommitted": true,
    "diffEditor.experimental.showMoves": true,
    "hediet.vscode-drawio.resizeImages": null,
    "prettyxml.settings.formatOnSave": true,
    "shellformat.useEditorConfig": true,
    "editor.detectIndentation": false,
    "remote.SSH.connectTimeout": 30,
    "remote.SSH.showLoginTerminal": true,
    "remote.SSH.localServerDownload": "always",
    "git.confirmSync": false,
    "editor.fontSize": 16,
    "shellcheck.customArgs": [
        "-x"
    ],
    "diffEditor.renderSideBySide": true,
    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.maxComputationTime": 0,
    "workbench.editor.enablePreview": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "diffviewer.outputFormat": "side-by-side",
    "cSpell.ignorePaths": [
        "package-lock.json",
        "node_modules",
        "vscode-extension",
        ".git/objects",
        ".vscode",
        ".vscode-insiders",
        ".cspell.json",
        ".cspell/*.dict",
    ],
    "notebook.defaultFormatter": "oliver-ni.scheme-fmt",
    "editor.inlineSuggest.suppressSuggestions": true,
    "prettyxml.settings.indentSpaceLength": 2,
    "prettyxml.settings.attributesInNewlineThreshold": 9,
    "workbench.secondarySideBar.showLabels": false,
    "security.allowedUNCHosts": [
        "calligraphy-wyrm.stealthdragonland.net",
        "castellan.stealthdragonland.net",
    ],
    "editor.unicodeHighlight.nonBasicASCII": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
    },
    "workbench.editor.autoLockGroups": {
        "mainThreadWebview-markdown.preview": true,
        "cweijan.markdownViewer.optional": true,
    },
    "editor.minimap.enabled": false,
    "workbench.editor.revealIfOpen": true,
    "[markdown]": {
        "diffEditor.ignoreTrimWhitespace": false,
    },
    "taskExplorer.clickAction": "Execute",
    "taskExplorer.enableSideBar": true,
    "taskExplorer.enableExplorerView": false,
    "taskExplorer.groupMaxLevel": 4,
    "taskExplorer.showHiddenWsTasks": false,
    "taskExplorer.showLastTasks": false,
    "taskExplorer.showFavoritesButton": false,
    "explorer.confirmPasteNative": false,
    "terminal.integrated.rightClickBehavior": "paste",
    "chat.disableAIFeatures": true,
    "settingsSync.ignoredExtensions": [
        "nimcitylabs.wysiwyg-html-editor"
    ],
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "editor.formatOnSave": true,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "yaml.format.singleQuote": true,
    "workbench.colorTheme": "Dark Modern",
    "terminal.integrated.fontFamily": "Lucida Sans Typewriter",
    "workbench.colorCustomizations": {
        "focusBorder": "#3465A4",
        "foreground": "#D3D7CF",
        "widget.border": "#555753",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#EEEEEC",
        "activityBar.inactiveForeground": "#555753",
        "activityBarBadge.background": "#3465A4",
        "activityBarBadge.foreground": "#EEEEEC",
        "sideBar.background": "#000000",
        "sideBar.foreground": "#D3D7CF",
        "sideBar.border": "#555753",
        "sideBarTitle.foreground": "#D3D7CF",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.foreground": "#D3D7CF",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#D3D7CF",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#555753",
        "statusBar.background": "#3465A4",

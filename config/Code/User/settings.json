        "statusBar.noFolderBackground": "#75507B",
        "statusBar.debuggingBackground": "#CC0000",
        "statusBar.debuggingForeground": "#EEEEEC",
        "statusBarItem.remoteBackground": "#4E9A06",
        "tab.activeBackground": "#000000",
        "tab.activeForeground": "#EEEEEC",
        "tab.inactiveBackground": "#000000",
        "tab.inactiveForeground": "#555753",
        "tab.border": "#555753",
        "tab.activeBorderTop": "#3465A4",
        "editorGroupHeader.tabsBackground": "#000000",
        "editor.background": "#000000",
        "editor.foreground": "#D3D7CF",
        "editorCursor.foreground": "#FFFFFF",
        "editor.selectionBackground": "#3465A466",
        "editor.lineHighlightBackground": "#55575333",
        "editorLineNumber.foreground": "#555753",
        "editorLineNumber.activeForeground": "#D3D7CF",
        "editorWidget.background": "#000000",
        "editorWidget.border": "#555753",
        "panel.background": "#000000",
        "panel.border": "#555753",
        "panelTitle.activeForeground": "#EEEEEC",
        "panelTitle.inactiveForeground": "#555753",
        "terminal.background": "#000000",
        "terminal.foreground": "#D3D7CF",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiRed": "#CC0000",
        "terminal.ansiGreen": "#4E9A06",
        "terminal.ansiYellow": "#C4A000",
        "terminal.ansiBlue": "#3465A4",
        "terminal.ansiMagenta": "#75507B",
        "terminal.ansiCyan": "#06989A",
        "terminal.ansiWhite": "#D3D7CF",
        "terminal.ansiBrightBlack": "#555753",
        "terminal.ansiBrightRed": "#EF2929",
        "terminal.ansiBrightGreen": "#8AE234",
        "terminal.ansiBrightYellow": "#FCE94F",
        "terminal.ansiBrightBlue": "#729FCF",
        "terminal.ansiBrightMagenta": "#AD7FA8",
        "terminal.ansiBrightCyan": "#34E2E2",
        "terminal.ansiBrightWhite": "#EEEEEC",
        "terminalCursor.foreground": "#FFFFFF",

# Linked to ~/.config/mako/config by link-user-config.

font=Hack 11
width=500
height=200
anchor=top-right
margin=12
padding=12
border-size=2
border-radius=10
layer=overlay

# Palette from config/kitty/kitty.conf (Tango Dark).
# Border color follows the Hyprland gradient by urgency:
# blue #3465A4 -> purple #75507B -> red #CC0000.
background-color=#000000ff
text-color=#D3D7CFff
border-color=#75507Bff
progress-color=over #75507Bff

default-timeout=5000
ignore-timeout=1
max-visible=-1
max-history=50

[urgency=low]
border-color=#3465A4ff
progress-color=over #3465A4ff

[urgency=normal]
border-color=#75507Bff
progress-color=over #75507Bff

[urgency=critical]
border-color=#CC0000ff
progress-color=over #CC0000ff
default-timeout=0

# KDE Connect forwards phone Visual Voicemail / carrier VM toasts.
# Only summary~ and body~ accept regex. app-name is exact-match only.
[summary~=.*[Vv]oice.?[Mm]ail.*]
invisible=1

[body~=.*[Vv]oice.?[Mm]ail.*]
invisible=1

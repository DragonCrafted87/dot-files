[Unit]
Description=HTPC graphical session extras for Hyprland
Documentation=file://%h/dot-files/config/hypr/README.md
PartOf=graphical-session.target
After=graphical-session-pre.target hyprland-session.service
Wants=hyprland-session.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Filled in later PRs (qs htpc, hidden Kodi, Guide helper).
ExecStart=/usr/bin/true
Slice=session.slice

[Install]
WantedBy=graphical-session.target

# Linked to ~/.gitconfig by link-home-files.

[user]
	name = Scott Gudeman
	email = 24697493+DragonCrafted87@users.noreply.github.com
[core]
	editor = nano
	autocrlf = false
	fsmonitor = true
	longpaths = true
[init]
	templatedir = ~/.config/git/template
[push]
	default = current
[pull]
	rebase = false
[safe]
	directory = *
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = cyan
	frag = magenta
	old = red
	new = green
[color "status"]
	added = green
	changed = yellow
	untracked = cyan

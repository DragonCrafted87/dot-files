# managed by dot-files configure-mime-defaults
# Default handlers for Dolphin / xdg-open after Plasma is stripped.
# Desktop ids match OpenMandriva KF6 + distro LibreOffice packages.
# Text and source files open in VS Code, not Kate / KWrite.

[Default Applications]
inode/directory=org.kde.dolphin.desktop
application/x-code-workspace=code.desktop
text/plain=code.desktop
text/markdown=code.desktop
text/x-markdown=code.desktop
text/csv=libreoffice-calc.desktop
text/css=code.desktop
text/html=brave-browser.desktop
text/xml=code.desktop
text/javascript=code.desktop
text/x-python=code.desktop
text/x-python3=code.desktop
text/x-shellscript=code.desktop
text/x-csrc=code.desktop
text/x-c++src=code.desktop
text/x-chdr=code.desktop
text/x-c++hdr=code.desktop
text/x-java=code.desktop
text/x-rust=code.desktop
text/x-go=code.desktop
text/x-cmake=code.desktop
text/x-makefile=code.desktop
text/x-patch=code.desktop
text/x-diff=code.desktop
text/x-log=code.desktop
text/x-yaml=code.desktop
text/yaml=code.desktop
application/json=code.desktop
application/javascript=code.desktop
application/x-shellscript=code.desktop
application/xml=code.desktop
application/x-yaml=code.desktop
application/toml=code.desktop
application/x-desktop=code.desktop
inode/x-empty=code.desktop
application/pdf=org.kde.okular.desktop
application/x-gzpdf=org.kde.okular.desktop
application/x-bzpdf=org.kde.okular.desktop
application/epub+zip=org.kde.okular.desktop
application/vnd.oasis.opendocument.text=libreoffice-writer.desktop
application/vnd.oasis.opendocument.text-template=libreoffice-writer.desktop
application/vnd.oasis.opendocument.spreadsheet=libreoffice-calc.desktop
application/vnd.oasis.opendocument.spreadsheet-template=libreoffice-calc.desktop
application/vnd.oasis.opendocument.presentation=libreoffice-impress.desktop
application/vnd.oasis.opendocument.presentation-template=libreoffice-impress.desktop
application/vnd.oasis.opendocument.graphics=libreoffice-draw.desktop
application/vnd.oasis.opendocument.formula=libreoffice-math.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.document=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.template=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop

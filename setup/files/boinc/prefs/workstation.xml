<global_preferences>
    <!-- Hyprland/Flatpak does not report user idle, so run_if_user_active
         and idle_time_to_run cannot protect the desktop. Cap cores/RAM
         instead and keep GPU off. -->
    <run_on_batteries>0</run_on_batteries>
    <run_if_user_active>1</run_if_user_active>
    <run_gpu_if_user_active>0</run_gpu_if_user_active>
    <suspend_cpu_usage>20.0</suspend_cpu_usage>
    <max_ncpus_pct>35.0</max_ncpus_pct>
    <cpu_usage_limit>50.0</cpu_usage_limit>
    <ram_max_used_idle_pct>40.0</ram_max_used_idle_pct>
    <ram_max_used_busy_pct>25.0</ram_max_used_busy_pct>
    <vm_max_used_pct>50.0</vm_max_used_pct>
    <idle_time_to_run>0.0</idle_time_to_run>
    <leave_apps_in_memory>0</leave_apps_in_memory>
</global_preferences>

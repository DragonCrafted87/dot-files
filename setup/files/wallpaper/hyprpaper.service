[Unit]
Description=hyprpaper wallpaper daemon
Documentation=file://%h/dot-files/config/hypr/README.md
PartOf=graphical-session.target
After=graphical-session.target hyprland-session.service
ConditionPathExists=%h/.local/state/hypr/hyprpaper.conf

[Service]
Type=simple
# Own cgroup. astro-wallpaper.service is Type=oneshot with
# KillMode=control-group, so a hyprpaper it spawned dies when refresh exits.
ExecStart=/usr/local/bin/hyprpaper -c %h/.local/state/hypr/hyprpaper.conf
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target

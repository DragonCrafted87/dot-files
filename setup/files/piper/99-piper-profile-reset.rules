# Logitech G603/G604 over Lightspeed (receiver 046d:c539) or Bluetooth.
# ACTION!="remove" is required on systemd 258+; add-only matches miss bind.
#
# ratbagd only enumerates initialized hidraw, then watches hidraw ADD/REMOVE.
# Lightspeed child nodes (HID++ 046d:406c / 046d:4085) appear after the
# receiver, so a login-time ratbagd often sees only 046d:c539 and ignores it.
# hid-logitech-hidpp bind is the moment the real mouse node exists; replay
# hidraw ADD so ratbagd retries (ratbagd-hidraw-rescan.service).
ACTION!="remove", SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="406c", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="reset-piper-profile.service"
ACTION!="remove", SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="c539", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="reset-piper-profile.service"
ACTION=="bind", SUBSYSTEM=="hid", DRIVER=="logitech-hidpp-device", ATTRS{idVendor}=="046d", TAG+="systemd", ENV{SYSTEMD_WANTS}+="ratbagd-hidraw-rescan.service", ENV{SYSTEMD_USER_WANTS}+="reset-piper-profile.service"

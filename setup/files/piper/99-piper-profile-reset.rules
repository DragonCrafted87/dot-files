# Logitech G603 (and its Lightspeed receiver). Starts the user oneshot
# that forces Piper/ratbag profile 0 after Windows G HUB rewrites storage.
# ACTION!="remove" is required on systemd 258+; add-only matches miss bind.
ACTION!="remove", SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="406c", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="reset-piper-profile.service"
ACTION!="remove", SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="c539", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="reset-piper-profile.service"
ACTION!="remove", KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="406c", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="reset-piper-profile.service"
ACTION!="remove", KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="b01c", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="reset-piper-profile.service"
